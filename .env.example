# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Runtime queries — use the pooled "Transaction" connection string (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Max connections per server instance (default 5).
DATABASE_POOL_MAX="5"
# Migrations — use the direct or "Session" connection string (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# The public anon / publishable key. Safe for the browser; tables are locked by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Site ─────────────────────────────────────────────────────────────────────
# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# "true" only on the final production domain. Anything else sends noindex.
SITE_INDEXING="false"
# Random secret used to hash contact-form IP addresses for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=""

# ─── Seed only (npm run db:seed) — creates the first super admin ──────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Website Administrator"
